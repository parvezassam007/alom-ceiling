<!-- FIREBASE + CLOUDINARY -->

<script type="module">

import { initializeApp }
from "https://www.gstatic.com/firebasejs/12.18.0/firebase-app.js";

import {
getFirestore,
collection,
addDoc,
getDocs,
query,
orderBy,
serverTimestamp
}
from "https://www.gstatic.com/firebasejs/12.18.0/firebase-firestore.js";


/* FIREBASE */

const firebaseConfig = {

apiKey:"AIzaSyBYiDDomTG5KiFakSTAtobFiN1AiYo6E3M",

authDomain:"alom-works.firebaseapp.com",

projectId:"alom-works",

storageBucket:"alom-works.firebasestorage.app",

messagingSenderId:"175015007998",

appId:"1:175015007998:web:eb8871981d7ae7848477af"

};


const app = initializeApp(firebaseConfig);

const db = getFirestore(app);


/* CLOUDINARY */

const CLOUD_NAME = "egmwvmxe";

const UPLOAD_PRESET = "alom_works";

const CLOUDINARY_URL =
`https://api.cloudinary.com/v1_1/${CLOUD_NAME}/image/upload`;


/* ELEMENTS */

const input =
document.getElementById("photoInput");

const grid =
document.getElementById("galleryGrid");


/* MENU */

window.toggleMenu = function(){

document
.getElementById("navLinks")
.classList.toggle("show");

};


/* SHOW PHOTOS */

async function loadGallery(){

grid.innerHTML = `
<div class="empty">
⏳ Loading project photos...
</div>
`;

try{

const q = query(
collection(db,"photos"),
orderBy("createdAt","desc")
);

const snapshot = await getDocs(q);

grid.innerHTML = "";

if(snapshot.empty){

grid.innerHTML = `
<div class="empty">
📸 No project photos yet.
</div>
`;

return;
}


snapshot.forEach(doc => {

const photo = doc.data();

const div =
document.createElement("div");

div.className = "photo";

div.innerHTML = `

<img
src="${photo.url}"
alt="Alom Works Project">

<div class="photo-label">
${photo.category || "Alom Works"}
</div>

`;

const image =
div.querySelector("img");

image.onclick = function(){

document
.getElementById("lightboxImage")
.src = photo.url;

document
.getElementById("lightbox")
.classList.add("show");

};

grid.appendChild(div);

});

}catch(error){

console.error(error);

grid.innerHTML = `
<div class="empty">
❌ Gallery load nahi hui.<br><br>
Firebase Firestore setup check karo.
</div>
`;

}

}


/* UPLOAD */

input.addEventListener("change",async function(event){

const files = [...event.target.files];

if(!files.length)return;


for(const file of files){

try{

let category = prompt(
"Photo category likho:\nElectrical\nFalse Ceiling\nPVC\nPlumbing",
"Electrical"
);

if(!category) category="Electrical";


/* CLOUDINARY */

const formData = new FormData();

formData.append("file",file);

formData.append(
"upload_preset",
UPLOAD_PRESET
);

formData.append(
"folder",
"alom_works"
);


alert("⏳ Photo upload ho rahi hai...");


const cloudinaryResponse =
await fetch(
CLOUDINARY_URL,
{
method:"POST",
body:formData
}
);


const cloudinaryData =
await cloudinaryResponse.json();


if(!cloudinaryResponse.ok){

throw new Error(
cloudinaryData.error?.message ||
"Cloudinary upload failed"
);

}


const imageUrl =
cloudinaryData.secure_url;


/* FIRESTORE */

await addDoc(
collection(db,"photos"),
{

url:imageUrl,

category:category,

createdAt:serverTimestamp()

}
);


alert("✅ Photo sabke liye upload ho gayi!");


}catch(error){

console.error(error);

alert(
"❌ Upload failed:\n\n" +
error.message
);

}

}


input.value="";

await loadGallery();

});


/* LIGHTBOX */

window.closeLightbox = function(){

document
.getElementById("lightbox")
.classList.remove("show");

};


/* START */

loadGallery();

</script>

